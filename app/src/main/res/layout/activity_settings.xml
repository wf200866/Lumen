<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0E0E12"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="设置"
            android:textColor="#E8E8F0"
            android:textSize="22sp"
            android:textStyle="bold" />

        <!-- ═══════════ 后端 ═══════════ -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="计算后端"
            android:textColor="#8A8AA0"
            android:textSize="13sp" />

        <RadioGroup
            android:id="@+id/rg_backend"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="vertical">

            <RadioButton
                android:id="@+id/rb_cpu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:buttonTint="#66D9A0"
                android:text="CPU　稳定，约 7 分钟/张，手机正常用"
                android:textColor="#C0C0D0"
                android:textSize="13sp" />

            <RadioButton
                android:id="@+id/rb_opencl"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:buttonTint="#D9A066"
                android:text="GPU　实验性，同速度但会更耗电发烫"
                android:textColor="#D0B0A0"
                android:textSize="13sp" />
        </RadioGroup>

        <TextView
            android:id="@+id/tv_gpu_warn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="#1E1512"
            android:padding="10dp"
            android:text="⚠ GPU 模式：Adreno 730 与 CPU 共享内存总线，跑图时会抢占带宽，可能造成界面卡顿。已自动限带宽+降优先级，但仍建议在手机闲置时使用。速度不比 CPU 快。"
            android:textColor="#D9A066"
            android:textSize="11sp"
            android:visibility="gone" />

        <!-- ═══════════ 超分 ═══════════ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="超分 2×"
                    android:textColor="#C0C0D0"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/tv_upscale_hint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Lanczos3 重采样，512 → 1024，不改变内容"
                    android:textColor="#6A6A7A"
                    android:textSize="10sp" />
            </LinearLayout>

            <Switch
                android:id="@+id/sw_upscale"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <!-- ═══════════ 模型 ═══════════ -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="模型目录"
            android:textColor="#8A8AA0"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/et_model_dir"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="#16161E"
            android:inputType="text"
            android:padding="10dp"
            android:textColor="#E0E0EC"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tv_model_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="#101018"
            android:fontFamily="monospace"
            android:padding="10dp"
            android:text=""
            android:textColor="#7A9A88"
            android:textSize="11sp" />

        <!-- ═══════════ 后端管理 ═══════════ -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="后端进程"
            android:textColor="#8A8AA0"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tv_backend_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="#101018"
            android:fontFamily="monospace"
            android:padding="10dp"
            android:text=""
            android:textColor="#88AABB"
            android:textSize="11sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_be_start"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="1"
                android:backgroundTint="#2A3A32"
                android:text="启动"
                android:textColor="#88DDB0"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btn_be_stop"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:backgroundTint="#2A2A32"
                android:text="停止"
                android:textColor="#B0B0C0"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btn_be_log"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:backgroundTint="#2A2A32"
                android:text="日志"
                android:textColor="#B0B0C0"
                android:textSize="12sp" />
        </LinearLayout>

        <Button
            android:id="@+id/btn_gpu_stop"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:layout_marginTop="6dp"
            android:backgroundTint="#3A2020"
            android:text="GPU 紧急停止 + 恢复系统"
            android:textColor="#E08080"
            android:textSize="12sp" />

        <!-- ═══════════ 尺寸 ═══════════ -->
        <TextView
            android:id="@+id/tv_size"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="512 × 512"
            android:textColor="#C0C0D0"
            android:textSize="13sp" />

        <SeekBar
            android:id="@+id/sb_size"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:progressTint="#66D9A0"
            android:thumbTint="#66D9A0" />

        <!-- ═══════════ CFG ═══════════ -->
        <TextView
            android:id="@+id/tv_cfg"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="CFG 1.0"
            android:textColor="#C0C0D0"
            android:textSize="13sp" />

        <SeekBar
            android:id="@+id/sb_cfg"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:progressTint="#66D9A0"
            android:thumbTint="#66D9A0" />

        <!-- ═══════════ LoRA ═══════════ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="启用 DMD LoRA（画质关键）"
                android:textColor="#C0C0D0"
                android:textSize="13sp" />

            <Switch
                android:id="@+id/sw_lora"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_lora"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="1.00"
            android:textColor="#C0C0D0"
            android:textSize="13sp" />

        <SeekBar
            android:id="@+id/sb_lora"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:progressTint="#66D9A0"
            android:thumbTint="#66D9A0" />

        <!-- ═══════════ 线程 ═══════════ -->
        <TextView
            android:id="@+id/tv_threads"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="CPU 线程 6"
            android:textColor="#C0C0D0"
            android:textSize="13sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="8 核建议留 2 个给系统，开满会导致界面无响应"
            android:textColor="#6A6A7A"
            android:textSize="10sp" />

        <SeekBar
            android:id="@+id/sb_threads"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:progressTint="#66D9A0"
            android:thumbTint="#66D9A0" />

        <Button
            android:id="@+id/btn_save_settings"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="20dp"
            android:backgroundTint="#66D9A0"
            android:text="保存"
            android:textColor="#0E0E12"
            android:textSize="15sp"
            android:textStyle="bold" />

    </LinearLayout>
</ScrollView>